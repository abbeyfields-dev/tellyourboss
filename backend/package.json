{
  "name": "bossorater-api",
  "version": "1.0.0",
  "private": true,
  "description": "Boss-Rater API — save scorecards for many people",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "NODE_ENV=development nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "bash scripts/prisma-with-gcp-secret.sh migrate dev",
    "prisma:studio": "bash scripts/prisma-with-gcp-secret.sh studio",
    "prisma:deploy": "bash scripts/prisma-with-gcp-secret.sh migrate deploy",
    "deploy:dev": "bash scripts/deploy-dev.sh",
    "gcp:provision": "bash scripts/provision-gcp.sh"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.7",
    "prisma": "5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  }
}
