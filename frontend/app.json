{
  "expo": {
    "name": "Boss-O-Rater",
    "slug": "tellyourboss",
    "owner": "navayro-founders",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/boss-rater-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/boss-rater-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.navayro.bossorater",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.navayro.bossorater",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/boss-rater-icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "8d201f6c-7b41-4457-80d3-e5bb20f574f0"
      }
    },
    "experiments": {
      "baseUrl": ""
    }
  }
}
